alias ve='source env/bin/activate'
alias de='deactivate'

alias pip='uv pip'

alias jl='jupyter lab'

alias yt='uvx yt-dlp'
alias yt-en='yt --embed-subs --sub-langs en --convert-subs srt'
alias yt-de='yt --embed-subs --sub-langs de --convert-subs srt'
alias yt-subs='yt --list-subs'

function mkenv {
    if [ "$1" = "dist" ]; then
        python3 -m venv env
        source env/bin/activate
        pip install --upgrade pip wheel setuptools
    else
        if [ -z "$1" ]; then
            uv venv env --allow-existing
        else
            uv venv env --allow-existing --python $1
        fi

        source env/bin/activate
        uv pip install --upgrade pip wheel setuptools
    fi
}

function rmenv {
    deactivate
    rm -r env
}

function clean-python {
    find . -type f -name *.pyc -delete
    find . -type d -name __pycache__ -delete
}
