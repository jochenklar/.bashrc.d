alias gits='git status'
alias gitc='git commit -am'
alias gitl='git log --oneline'
alias gitb='git branch'

gitbu() {
    git branch -u origin/`git branch --show-current`
}
gitcu() {
    git fetch
    git checkout $1
}
gitpr() {
    git fetch origin pull/$1/head:pr/$1
    git checkout pr/$1
}
gityolo() {
    git add . && git commit --amend --no-edit && git push -f origin test
}
gitcompare() {
    diff --color <(git show $1) <(git show $2)
}

parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1) /'
}

gitrepos() {
    local command=$1
    shift
    for path in "$@"; do
        echo "~~~ ${path} ~~~"
        git -C "$path" $command
        echo
    done
}

gitdiff() {
    local ref1="${1}"
    local ref2="${2}"
    local output="${3:-$HOME/Desktop/diff.txt}"

    if [[ -n "$ref1" && -n "$ref2" ]]; then
        git diff "${ref1}..${ref2}" > "${output}"
    elif [[ -n "$ref1" ]]; then
        git diff "${ref1}" > "${output}"
    else
        git diff > "${output}"
    fi
}
